{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "store_id": {
        "type": "string",
        "description": "Caller-supplied ID or normalized merchant domain"
      },
      "domain": {
        "type": "string",
        "description": "Audited public merchant domain"
      },
      "ucp_version": {
        "type": [
          "string",
          "null"
        ],
        "description": "Detected ucp.version YYYY-MM-DD string"
      },
      "status": {
        "type": "string",
        "description": "compliant, action_required, non_compliant, blocked_ssrf, fetch_error, or parse_error"
      },
      "score": {
        "type": [
          "integer",
          "null"
        ],
        "description": "10-gate UCP readiness score from 0 to 100"
      },
      "grade": {
        "type": [
          "string",
          "null"
        ],
        "description": "Letter grade A through F"
      },
      "gates_passed": {
        "type": "integer",
        "description": "Count of passing UCP gates out of 10"
      },
      "gates_failed": {
        "type": "integer",
        "description": "Count of failing UCP gates"
      },
      "findings_count": {
        "type": "integer",
        "description": "Total actionable findings across all 10 gates"
      }
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": [
          "store_id",
          "domain",
          "ucp_version",
          "status",
          "score",
          "grade",
          "gates_passed",
          "gates_failed",
          "findings_count"
        ]
      },
      "display": {
        "component": "table"
      }
    }
  }
}
